# =============================================================================
# SeamlessAccess demo environment — copy to .env and edit, then run scripts/up.sh
# =============================================================================
# The .env file is gitignored. Every hostname and entityID below is consumed
# both by docker-compose.yml (vhost routing, container env) and by the template
# renderer (scripts/render.sh) which fills the XML / JSON / Apache / Shibboleth
# config from the *.tmpl files. Keep them consistent — change a name here and
# re-run scripts/up.sh and everything downstream follows.

# -----------------------------------------------------------------------------
# TLS / DNS mode  (see plan.md §8)
# -----------------------------------------------------------------------------
# local       -> private names in each client's /etc/hosts + a local CA
#                (scripts/gen-tls-local.sh mints the certs). acme-companion does
#                NOT start. This is the default for a lab VM.
# letsencrypt -> public DNS for names you OWN + inbound :80 reachable.
#                acme-companion issues/renews real certs. The *.org names below
#                are placeholders — replace with domains you control.
TLS_MODE=local

# local mode only: the address where nginx-proxy is reachable, put into the
# /etc/hosts line that up.sh prints. Set 127.0.0.1 if you browse the demo on the
# same machine that runs Docker; otherwise the Docker host's LAN/VM IP.
# (Do NOT leave this at a placeholder — 192.0.2.x is RFC 5737 documentation
# space and does not route anywhere.)
VM_IP=127.0.0.1

# letsencrypt mode only: contact address for Let's Encrypt (leave blank in local)
LETSENCRYPT_EMAIL=

# -----------------------------------------------------------------------------
# Domains (configurable — these defaults only resolve in local mode)
# -----------------------------------------------------------------------------
SA_DOMAIN=sa.org
IDP_HOST=idp.org
IDP2_HOST=login.uni-cazalla.net
SP1_HOST=sp1.org
SP2_HOST=sp2.org
MDQ_HOST=md.sa.org
SERVICE_HOST=service.sa.org

# Persistence context used by the DS and by SP2's advanced-mode custom button.
# Optional; defaults to "local" in both docker-compose.yml and render.sh.
#DEFAULT_CONTEXT=local

# -----------------------------------------------------------------------------
# SAML identifiers (single source of truth — reused in XML, discojson, configs)
# -----------------------------------------------------------------------------
IDP_ENTITYID=https://idp.org/idp/shibboleth
IDP_SCOPE=idp.org
# Second IdP — a separate institution in the same federation. Both SPs trust it
# and it appears as a real, selectable entry in the discovery service.
IDP2_ENTITYID=https://login.uni-cazalla.net/idp/shibboleth
IDP2_SCOPE=uni-cazalla.net
SP1_ENTITYID=https://sp1.org/shibboleth
SP2_ENTITYID=https://sp2.org/shibboleth

# -----------------------------------------------------------------------------
# Build versions for the thiss-js image (both must exist under ../dist-pre/)
# -----------------------------------------------------------------------------
THISS_VERSION=2.1.179
THISS_PREV_VERSION=2.1.169

# -----------------------------------------------------------------------------
# Demo users (one static account per IdP). The login is the same at both IdPs
# for convenience; the released identity (eduPersonPrincipalName is scoped, plus
# displayName / mail) differs so you can tell which institution you signed in
# through.
# -----------------------------------------------------------------------------
DEMO_USER=demo
DEMO_PASS=demopassword
DEMO_DISPLAYNAME="Demo User"
DEMO_MAIL=demo@idp.org

# Second IdP's static account (Universidad de Cazalla)
DEMO2_USER=demo
DEMO2_PASS=demopassword
DEMO2_DISPLAYNAME="Carmen Ruiz (Cazalla)"
DEMO2_MAIL=carmen@uni-cazalla.net

# -----------------------------------------------------------------------------
# Pinned image tags (override if the documented tags become unavailable)
# -----------------------------------------------------------------------------
NGINX_PROXY_TAG=1.6
ACME_COMPANION_TAG=2.4
# Maintained Shibboleth IdP v5 image (Internet2/InCommon). `latest5` tracks the
# newest v5 build; pin a dated tag like 5.1.6_20251106_rocky9_multiarch for
# reproducibility. (The old unicon/shibboleth-idp image is abandoned at v3.)
IDP_IMAGE=i2incommon/shib-idp:latest5

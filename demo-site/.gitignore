# Operator-created config — never commit
.env
scripts/.certs-env.sh

# TLS material for nginx-proxy (LE writes it, or gen-tls-local.sh does)
certs/

# Generated SAML keypairs
idp/config/credentials/*.crt
idp/config/credentials/*.key
idp2/config/credentials/*.crt
idp2/config/credentials/*.key
sp1/credentials/*.crt
sp1/credentials/*.key
sp2/credentials/*.crt
sp2/credentials/*.key

# Rendered output of *.tmpl files (regenerated by scripts/render.sh)
metadata/idp-metadata.xml
metadata/idp2-metadata.xml
metadata/sp1-metadata.xml
metadata/sp2-metadata.xml
metadata/metadata.json
idp/config/conf/idp.properties
idp/config/conf/attribute-resolver.xml
idp/config/conf/attribute-filter.xml
idp/config/credentials/idp.htpasswd
idp2/config/conf/idp.properties
idp2/config/conf/attribute-resolver.xml
idp2/config/credentials/idp.htpasswd
sp1/shibboleth2.xml
sp1/apache-vhost.conf
sp1/html/index.html
sp1/html/secure/index.html
sp2/shibboleth2.xml
sp2/apache-vhost.conf
sp2/html/index.html
sp2/html/secure/index.html

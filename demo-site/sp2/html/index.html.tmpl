    <script src="/demo-toolbar/thiss-ds.js"></script>
    <script>
        // thiss-ds.js and thiss.js both claim window.thiss; capture the DS
        // client before the component bundle overwrites it.
        var thissDS = window.thiss;
    </script>
    <script src="https://${SERVICE_HOST}/thiss.js"></script>
    <script>
        // Integration Mode (demo toolbar, default "advanced"):
        //  - advanced: the SP-authored custom button; its label shows the
        //    institution the DS persisted, and it links to the SP's own
        //    /discovery/ page.
        //  - standard: the thiss.js DiscoveryComponent in #login, rendered
        //    lazily the first time standard mode is shown.
        window.onload = function () {
            var custom = document.getElementById('sa-custom');
            var login = document.getElementById('login');
            var change = document.querySelector('.access-change');
            var shibLogin = 'https://${SP2_HOST}/Shibboleth.sso/Login?target=https://${SP2_HOST}/secure/';
            var rendered = false;

            function currentMode() {
                try { return JSON.parse(localStorage.getItem('saDemoToolbar') || '{}').mode || 'advanced'; }
                catch (e) { return 'advanced'; }
            }
            function apply(mode) {
                var advanced = mode !== 'standard';
                custom.hidden = !advanced;
                login.hidden = advanced;
                change.href = advanced ? '/discovery/' : shibLogin;
                if (!advanced && !rendered) {
                    rendered = true;
                    thiss.DiscoveryComponent({
                        loginInitiatorURL: shibLogin,
                        entityID: '${SP2_ENTITYID}'
                    }).render('#login');
                }
            }
            apply(currentMode());
            document.addEventListener('sa:demo-mode', function (e) { apply(e.detail); });

            // Advanced integration: read the persisted choice through
            // thiss-ds (same PERSISTENCE_URL and context as the DS).
            new thissDS.PersistenceService('https://${SERVICE_HOST}/ps/')
                .entities('${DEFAULT_CONTEXT}')
                .then(function (result) {
                    var items = result && result.data;
                    if (items && items.length && items[0].entity && items[0].entity.title) {
                        custom.querySelector('.sa-custom-text').textContent =
                            'Access through ' + items[0].entity.title;
                    }
                })
                .catch(function () { /* no persisted choice — keep the generic label */ });
        };
    </script>

    <!-- ============================================================
         Demo instructions overlay — implements the Figma "Advanced

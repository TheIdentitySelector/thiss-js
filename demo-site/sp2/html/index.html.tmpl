    <script>
        (function () {
            var overlay = document.getElementById('demo-overlay');
            if (!overlay) return;
            // To show only once per visitor, wrap the reveal below in:
            //   if (localStorage.getItem('demoOverlayDismissed')) return;
            // and call localStorage.setItem('demoOverlayDismissed', '1') in hide().
            function hide() {
                overlay.setAttribute('hidden', '');
                document.removeEventListener('keydown', onKey);
            }
            function onKey(e) { if (e.key === 'Escape') hide(); }
            overlay.removeAttribute('hidden');
            document.addEventListener('keydown', onKey);
            overlay.addEventListener('click', function (e) { if (e.target === overlay) hide(); });
            overlay.querySelector('.demo-overlay__close').addEventListener('click', hide);
            overlay.querySelector('.demo-overlay__continue').addEventListener('click', hide);
        })();
    </script>
    <script src="/demo-toolbar/demo-toolbar.js" defer></script>

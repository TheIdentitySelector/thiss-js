            background: #216e93; color: #fff; font-family: inherit; font-size: 14px; cursor: pointer;
        }
    </style>
    <div id="demo-overlay" class="demo-overlay" role="dialog" aria-modal="true" aria-labelledby="demo-overlay-title" hidden>
        <div class="demo-overlay__card">
            <div class="demo-overlay__head">
                <h2 id="demo-overlay-title" class="demo-overlay__title">Advanced instructions</h2>

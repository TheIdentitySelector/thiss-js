<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>SeamlessAccess Upgrade Test - button host</title>
    <style>
        /* One button per document: loaded in an iframe by /upgrade-test/, so
           each thiss.js bundle gets its own window and its own zoid registry. */

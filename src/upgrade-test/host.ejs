        #cta { width: 350px; height: 85px; }
        .error { color: #c00; font: 13px -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; padding: 8px; }
    </style>
</head>
<body>
    <div id="cta"></div>
</body>
</html>
